# Seed task set — small, checkable, original. One JSON per line. Fields: id, shape, level (low|medium), prompt,
# check {type: equals|contains|regex|json|number, ...}, optional system, max_tokens, turns (multiturn only).
# Replace / extend with real sub-maker briefs from Turnstone once traffic exists (agentic-system-plan §9).
{"id": "rename-01", "shape": "bulk rename", "level": "low", "prompt": "Rename these files to kebab-case, keep extensions, one per line, nothing else:\nMyReport Final.PDF\nsetup_Notes.md\nQ3 Budget(v2).xlsx", "check": {"type": "contains", "value": ["myreport-final.pdf", "setup-notes.md", "q3-budget-v2.xlsx"]}}
{"id": "extract-01", "shape": "extract fields", "level": "low", "prompt": "Return only JSON with keys host, port, user from this line: 'connect to db07.internal on port 5433 as svc_report'.", "check": {"type": "json", "fields": {"host": "db07.internal", "port": 5433, "user": "svc_report"}}}
{"id": "format-01", "shape": "reformat table", "level": "low", "prompt": "Convert to CSV with header name,qty (no spaces, no extra text):\nbolts - 40\nnuts - 35\nwashers - 120", "check": {"type": "regex", "pattern": "name,qty\\s*\\n\\s*bolts,40\\s*\\n\\s*nuts,35\\s*\\n\\s*washers,120"}}
{"id": "count-01", "shape": "count from log", "level": "low", "prompt": "How many lines contain ERROR? Answer with the number only.\nINFO start\nERROR disk full\nWARN retry\nERROR disk full\nINFO done\nERROR timeout", "check": {"type": "number", "value": 3}}
{"id": "cmd-01", "shape": "command from spec", "level": "low", "prompt": "Give the single shell command that lists files in /var/log larger than 100 MB, using find. Command only.", "check": {"type": "regex", "pattern": "find\\s+/var/log.*-size\\s+\\+100M"}}
{"id": "logic-01", "shape": "diagnose failing check", "level": "medium", "prompt": "A cron job runs '0 3 * * 1-5 /opt/backup.sh' but the team says it never ran on Saturday 2026-10-17. Is that a bug? Answer yes or no first, then one sentence why.", "check": {"type": "regex", "pattern": "^\\W*no\\b"}}
{"id": "code-01", "shape": "small code change", "level": "medium", "prompt": "Python: this should return the median of a non-empty list but is wrong for even lengths. Give only the fixed function.\n\ndef median(xs):\n    s = sorted(xs)\n    return s[len(s)//2]", "check": {"type": "regex", "pattern": "(len\\(s\\)\\s*//\\s*2\\s*-\\s*1|len\\(s\\)\\s*%\\s*2)"}}
{"id": "calc-01", "shape": "capacity estimate", "level": "medium", "prompt": "A GPU has 2.08 GiB for KV cache. Each token needs 40 KiB. How many 32K-token conversations fit fully? Integer answer last.", "check": {"type": "number", "value": 1}}
{"id": "compare-01", "shape": "compare options", "level": "medium", "prompt": "Pick the option with the lowest total cost over 3 years and name it in the last line as 'Answer: X'. A: 900 upfront, 10/month. B: 0 upfront, 40/month. C: 300 upfront, 25/month.", "check": {"type": "regex", "pattern": "Answer:\\s*\\**C\\b"}}
{"id": "regex-01", "shape": "write regex", "level": "medium", "prompt": "Write one regular expression (only the pattern) that matches IPv4 addresses in 10.0.0.0/8 and nothing else, as a full-string match.", "check": {"type": "contains", "value": ["10\\."]}}
# multiturn: the model answers, each entry in turns comes back as the next user message (tool-result stand-in)
{"id": "loop-01", "shape": "stepwise investigation", "level": "medium", "prompt": "You are checking why a service fails to start. Ask for one piece of evidence at a time; when you know the cause, answer 'CAUSE: <cause>'.", "turns": ["Tool result: systemctl status shows 'code=exited, status=203/EXEC'.", "Tool result: ExecStart=/opt/app/run.sh ; ls -l /opt/app/run.sh -> -rw-r--r-- root root", "Tool result: nothing else unusual. Give your conclusion now."], "check": {"type": "regex", "pattern": "CAUSE:.*(exec|permission|chmod|executable)"}}
{"id": "loop-02", "shape": "stepwise data cleanup", "level": "low", "prompt": "Batch 1: amount=0. I will paste more rows one batch at a time. Keep a running total of the 'amount' column and reply only 'TOTAL: <n>' after each batch.", "turns": ["batch 2: amount=12; amount=30", "batch 3: amount=5", "batch 4: amount=50; amount=3. Final batch."], "check": {"type": "regex", "pattern": "TOTAL:\\s*100\\b"}}
